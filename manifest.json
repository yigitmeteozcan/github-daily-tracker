{
  "manifest_version": 3,
  "name": "GitHub Daily Tracker",
  "version": "1.0.0",
  "description": "Track your daily GitHub commits. Build your aura. Go cracked.",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://github.com/users/*/contributions"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-red-16.png",
      "48": "icons/icon-red-48.png",
      "128": "icons/icon-red-128.png"
    }
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
